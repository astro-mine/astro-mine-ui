# Node / pnpm
node_modules/
.pnpm-store/

# Build outputs
packages/*/dist/
apps/*/.next/
apps/*/out/
*.tsbuildinfo

# Generated by Next.js, and NOT committed despite the long-standing Next convention to commit it.
# Since the typed-routes reference was added, the file's contents differ between commands —
# `next dev` writes ./.next/dev/types/routes.d.ts and `next build` writes ./.next/types/routes.d.ts
# — so there is no single correct committed state. Tracking it made `git status` show a modified
# file after the most ordinary action in the repo, and made `git checkout` abort after `pnpm dev`.
# Nothing depends on it being in the tree: `tsc --noEmit` passes without it, and both commands
# regenerate it.
apps/*/next-env.d.ts

# Test artifacts
coverage/
playwright-report/
test-results/

# A developer's local runtime configuration. Untracked by construction: the app ships with no API
# endpoint configured so every page degrades visibly out of the box rather than pretending.
apps/console/public/config.json

# Editor / OS
.DS_Store
*.log

# Cesium's runtime assets, staged into the app by `scripts/copy-cesium-assets.mjs` before every
# build and every dev run (ui#6). Roughly 7.5 MB of workers, web assembly and widget files that
# Cesium fetches from `CESIUM_BASE_URL` rather than through the bundler — generated output, and
# generated output does not belong in the tree.
apps/console/public/cesium/
