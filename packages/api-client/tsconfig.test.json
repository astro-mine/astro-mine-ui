{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The tests, type-checked but never emitted.
  //
  // A second project rather than a wider `include` on the build one: `tsconfig.json` is
  // `composite`, the root solution file references it, and a composite project may not set
  // `noEmit` — so widening it would put the test files in `dist/` and in the published package.
  // This extends the shared base directly (not the composite project) for the same reason.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
