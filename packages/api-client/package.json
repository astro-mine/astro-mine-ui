{
  "name": "@astro-mine/api-client",
  "version": "0.0.0",
  "description": "The generated TypeScript client for astro-mine-api. The OpenAPI document is the contract; this package is its checked-in output plus configuration and error mapping.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astro-mine/astro-mine-ui.git",
    "directory": "packages/api-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "msw": "^2.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "msw": "^2.15.0",
    "vitest": "^4.1.10"
  }
}
