{
  "name": "@astro-mine/ui",
  "version": "0.0.0",
  "description": "The Astro-Mine design system \u2014 the Material UI theme (light and dark), the honesty kit, and every chart the application renders. No raw chart primitive leaves this package.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astro-mine/astro-mine-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test:contrast": "vitest run tests/contrast.test.ts tests/contrast-gate.test.ts",
    "test:palette": "vitest run tests/palette.test.ts tests/palette-gate.test.ts"
  },
  "dependencies": {
    "@mui/x-charts": "^9.11.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@testing-library/react": "^16.0.0",
    "axe-core": "^4.0.0",
    "vitest": "^4.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
